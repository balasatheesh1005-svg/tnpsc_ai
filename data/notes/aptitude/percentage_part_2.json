  "exam_importance": {
    "en": "Fraction and Percentage conversion is one of the most important TNPSC aptitude concepts. It is frequently used in Percentage, Ratio, Profit & Loss, Time & Work, Interest and Data Interpretation problems.",
    "ta": "பின்னம் மற்றும் சதவீத மாற்றம் TNPSC கணிதத்தில் மிகவும் முக்கியமான கருத்தாகும். இது சதவீதம், விகிதம், லாபம்-நஷ்டம், வேலை-நேரம், வட்டி மற்றும் தரவு விளக்கப்படங்களில் அதிகமாக பயன்படுத்தப்படுகிறது."
  },

  "definition": {
    "en": "This chapter explains Fraction to Percentage and Percentage to Fraction conversions.",
    "ta": "இந்தப் பகுதியில் பின்னத்தை சதவீதமாகவும், சதவீதத்தை பின்னமாகவும் மாற்றும் முறைகள் விளக்கப்படுகின்றன."
  },

  "formula_sheet": [
    {
      "title": "Fraction to Percentage",
      "formula": "Fraction × 100",
      "explanation": {
        "en": "Multiply the fraction by 100.",
        "ta": "பின்னத்தை 100-ஆல் பெருக்க வேண்டும்."
      }
    },
    {
      "title": "Percentage to Fraction",
      "formula": "Percentage / 100",
      "explanation": {
        "en": "Divide the percentage by 100 and simplify.",
        "ta": "சதவீதத்தை 100-ஆல் வகுத்து எளிமைப்படுத்த வேண்டும்."
      }
    }
  ],

