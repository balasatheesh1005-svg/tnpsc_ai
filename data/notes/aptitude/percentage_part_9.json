    {
      "id": 1,
      "title": {
        "en": "Family Budget Analysis",
        "ta": "குடும்ப வரவு-செலவு"
      },
      "background": {
        "en": "Realistic TNPSC Group 1 case study 1.",
        "ta": "TNPSC Group 1 நடைமுறை வழக்குக்கல்வி 1."
      },
      "given_data": {
        "en": [
          "Income is given.",
          "Expenditure is given.",
          "Percentage changes are applied."
        ],
        "ta": [
          "வருமானம் கொடுக்கப்பட்டுள்ளது.",
          "செலவு கொடுக்கப்பட்டுள்ளது.",
          "சதவீத மாற்றங்கள் கொடுக்கப்பட்டுள்ளன."
        ]
      },
      "question": {
        "en": "Find the final savings and savings percentage.",
        "ta": "இறுதி சேமிப்பு மற்றும் சேமிப்பு சதவீதத்தை காண்க."
      },
      "solution_framework": {
        "en": [
          "Find new income.",
          "Find new expenditure.",
          "Savings = Income − Expenditure.",
          "Find savings percentage."
        ],
        "ta": [
          "புதிய வருமானம்.",
          "புதிய செலவு.",
          "சேமிப்பு = வருமானம் − செலவு.",
          "சேமிப்பு சதவீதம்."
        ]
      },
      "shortcut": {
        "en": "Use multipliers.",
        "ta": "பெருக்கல் காரணிகளை பயன்படுத்தவும்."
      },
      "exam_trap": {
        "en": "Don't change the base value.",
        "ta": "அடிப்படை மதிப்பை மாற்ற வேண்டாம்."
      }
    },
