      },
      {
        "id": "B",
        "en": "Article 19(1)(d) (Freedom of Movement)",
        "ta": "உறுப்பு 19(1)(d) (நடமாடும் சுதந்திரம்)"
      },
      {
        "id": "C",
        "en": "Article 25 (Freedom of Conscience)",
        "ta": "உறுப்பு 25 (மனச்சாட்சி சுதந்திரம்)"
      },
      {
        "id": "D",
        "en": "Article 30 (Minority Rights)",
        "ta": "உறுப்பு 30 (சிறுபான்மையினர் உரிமைகள்)"
      }
