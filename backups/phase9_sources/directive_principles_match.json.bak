    "question_type": "Match the Following",
    "question": {
      "en": "Match List I (Articles of Part IV) with List II (Constitutional Provisions) and select the correct code:",
      "ta": "பட்டியல் I-ஐ (பகுதி IV உறுப்புகள்) பட்டியல் II உடன் (அரசியலமைப்பு விதிகள்) பொருத்தி சரியான குறியீட்டைத் தேர்ந்தெடுக்கவும்:"
    },
    "list_1": [
      {
        "id": "A",
        "en": "Article 36",
        "ta": "உறுப்பு 36"
      },
      {
        "id": "B",
        "en": "Article 37",
        "ta": "உறுப்பு 37"
      },
      {
        "id": "C",
        "en": "Article 38",
        "ta": "உறுப்பு 38"
      },
      {
        "id": "D",
        "en": "Article 39A",
        "ta": "உறுப்பு 39A"
      }
    ],
    "list_2": [
      {
        "id": "1",
        "en": "Definition of State for Part IV",
        "ta": "பகுதி IV-க்கான அரசு வரையறை"
      },
      {
        "id": "2",
        "en": "Non-justiciable nature of DPSP",
        "ta": "DPSP-ன் அமல்படுத்த முடியாத இயல்பு"
      },
      {
        "id": "3",
        "en": "Welfare social order informed by justice",
        "ta": "நீதி நிறைந்த நலன்சார் சமூக ஒழுங்கு"
      },
      {
        "id": "4",
        "en": "Equal justice and free legal aid",
        "ta": "சம நீதியும் இலவச சட்ட உதவியும்"
      }
    ],
    "options": [
      {
        "id": "A",
        "en": "A-1, B-2, C-3, D-4",
        "ta": "A-1, B-2, C-3, D-4"
      },
      {
        "id": "B",
        "en": "A-2, B-1, C-4, D-3",
        "ta": "A-2, B-1, C-4, D-3"
      },
      {
        "id": "C",
        "en": "A-1, B-3, C-2, D-4",
        "ta": "A-1, B-3, C-2, D-4"
      },
      {
        "id": "D",
        "en": "A-4, B-2, C-3, D-1",
        "ta": "A-4, B-2, C-3, D-1"
      }
    ],
    "correct_answer": "A",
    "explanation": {
      "en": "A-1: Art 36 defines State. B-2: Art 37 establishes non-justiciability. C-3: Art 38 directs welfare social order. D-4: Art 39A guarantees equal justice & free legal aid.",
      "ta": "A-1: உறுப்பு 36 அரசை வரையறுக்கிறது. B-2: உறுப்பு 37 அமல்படுத்த முடியாத தன்மையை நிறுவுகிறது. C-3: உறுப்பு 38 நலன்சார் சமூக ஒழுங்கை வழிகாட்டுகிறது. D-4: உறுப்பு 39A சம நீதி & இலவச சட்ட உதவியை உத்தரவாதம் செய்கிறது."
    },
    "why_not_others": {
      "A": {
        "en": "Correct. A-1, B-2, C-3, D-4 is the exact match.",
        "ta": "சரி. A-1, B-2, C-3, D-4 சரியான பொருத்தம்."
      },
      "B": {
        "en": "Incorrect. Article 36 matches 1, not 2.",
        "ta": "தவறு. உறுப்பு 36 பொருத்தம் 1 ஆகும்."
      },
      "C": {
        "en": "Incorrect. Article 38 matches 3, not 2.",
        "ta": "தவறு. உறுப்பு 38 பொருத்தம் 3 ஆகும்."
      },
      "D": {
        "en": "Incorrect. Article 39A matches 4, not 1.",
        "ta": "தவறு. உறுப்பு 39A பொருத்தம் 4 ஆகும்."
      }
    },
    "tnpsc_tip": {
      "en": "Art 36 adopts Art 12 State definition; Art 37 makes DPSP non-justiciable.",
      "ta": "உறுப்பு 36 உறுப்பு 12 அரசு வரையறையை ஏற்கிறது; உறுப்பு 37 DPSP-ஐ அமல்படுத்த முடியாததாக்குகிறது."
    },
    "question_en": "Match List I (Articles of Part IV) with List II (Constitutional Provisions) and select the correct code:",
    "question_ta": "பட்டியல் I-ஐ (பகுதி IV உறுப்புகள்) பட்டியல் II உடன் (அரசியலமைப்பு விதிகள்) பொருத்தி சரியான குறியீட்டைத் தேர்ந்தெடுக்கவும்:",
